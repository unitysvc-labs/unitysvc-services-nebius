{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
{#- Price-cell copy follows the marketplace description grammar
    (unitysvc/unitysvc#1886, PR #1887):

        <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

    BYOK is *why* the gateway price is free, so it rides the badge slot and
    renders as a pill beside the amount. A bare `~` selects the default
    intent — a saving — which is the green fill. The provider's reference
    rates ride the `|` note: that slot is taken first and consumed to
    end-of-string, so everything in it is inert — a rate card may contain
    "/" and "per" without being re-parsed as a unit. Only part of the catalog
    has rates (litellm covers the models it knows), so the note is
    conditional: without one the cell degrades to a bare "Free ~ BYOK" with
    no dangling separator.

    Composed here rather than written into the param file because
    scripts/update_params.py rebuilds list_price on the nightly populate run
    (02:00 UTC) and would drop a hand-edited description within a day.
    dict(...) overrides only the description, leaving price/type alone, and
    copies rather than mutates — update_params.py hands the SAME dict object
    to list_price and payout_price, and payout_price is seller-facing copy
    that must not pick up the customer-facing pill. #}
{%- set _rate = (' | usage is billed by ' ~ provider_display_name ~ ' directly at ' ~ pricing_note) if pricing_note else '' %}
  "list_price": {{ dict(list_price, description='Free ~ BYOK' ~ _rate) | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  {#- Every document below is DERIVED from what this service is: its
      capability and the request dialects it accepts (unitysvc/unitysvc#1899).
      The catalog-wide shape lives in unitysvc-data's `llm_example_collection`
      preset, so a new example flavour or a fixed preset reaches this repo on
      the next release rather than through a PR here.

      A collection covers ONE capability, so the embedding / vision / chat
      dispatch stays. Two things the hand-written block repeated on every
      document now ride the declaration:

      * `timeout` — how long the runner may let a document run before killing
        it (the backend's `resolve_test_timeout`; 30 s when absent).
        Qwen2.5-VL-72B-Instruct needs 120 s, set per service via the
        `test_timeout` param, and this is the only catalog that uses it.
      * `vision` — a group feature flag, so the vision branch selects the
        vision examples instead of naming all three by hand.

      Requires unitysvc-data with the `timeout` knob (unitysvc-data#67). -#}
  "documents": {
{%- if service_type == "embedding" %}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "sleep": 5,
      "timeout": {{ test_timeout | default(30) }}
    }
{%- elif is_vision %}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": [{"formats": ["openai", "anthropic"], "vision": true,
                   "tools": {{ (supports_function_calling | default(false)) | tojson }}}],
      "upstream_dialect": "openai",
      "sleep": 5,
      "timeout": {{ test_timeout | default(30) }}
    }
{%- else %}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": ["openai", "anthropic"],
      "upstream_dialect": "openai",
      {#- Tool examples 400 on models LiteLLM does not mark tool-capable. -#}
      "tools": {{ (supports_function_calling | default(false)) | tojson }},
      "sleep": 5,
      "timeout": {{ test_timeout | default(30) }}
    }
{%- endif %}
  }
}
