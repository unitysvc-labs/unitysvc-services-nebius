{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
  "list_price": {{ list_price | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  "documents": {
    "How to use this model": {
      "$doc_preset": "llm_description"
    }
{#- Per-service-type dispatch.  The chat-completion presets (llm_*) only
    apply to text LLMs; embeddings POST to /embeddings.  Vision-capable
    LLMs (``is_vision``) stay on the chat-completion shape but get
    image-aware code examples so the probe payload includes an image
    content block.  Sending the wrong-shape probe upstream returns 4xx
    and rejects the service.  Every EXECUTED doc (code examples +
    connectivity) carries meta.sleep_after_test to space out upstream
    probes; llm_description / llm_request_template are not executed. -#}
{%- if service_type == "embedding" %},
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_embed_requests", "meta": {"sleep_after_test": 5}}
    },
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_embed_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_embed_shell", "meta": {"sleep_after_test": 5}}
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity_embed", "meta": {"sleep_after_test": 5}}
    }
{#- No request-template preset for embeddings yet — the embed cURL
    example already shows the canonical request body.  Embeddings speak
    OpenAI only, so no Anthropic-dialect examples here. -#}
{%- elif is_vision %},
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_vision_requests", "meta": {"sleep_after_test": 5}}
    },
{%- if supports_function_calling %}
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },
{%- endif %}
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_vision_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_vision_shell", "meta": {"sleep_after_test": 5}}
    },
    {#- Anthropic-dialect examples (R9): the upstream speaks OpenAI, so
        specs run-tests (local_testing) calls it in OpenAI form, while the
        gateway path speaks Anthropic and exercises the llm_translator. #}
    "Python code example (Anthropic SDK)": {
      "category": "code_example",
      "description": "Anthropic Messages API via the anthropic SDK; the gateway translates to the upstream",
      "file_path": "anthropic-to-openai-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python",
      "meta": {"requirements": ["openai", "anthropic"], "sleep_after_test": 5}
    },
    "cURL code example (Anthropic style)": {
      "category": "code_example",
      "description": "Anthropic Messages API via cURL; the gateway translates to the upstream",
      "file_path": "anthropic-to-openai-code-example.sh.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "bash",
      "meta": {"sleep_after_test": 5}
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
{%- else %},
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_openai", "meta": {"sleep_after_test": 5}}
    },
{%- if supports_function_calling %}
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },
{%- endif %}
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "meta": {"sleep_after_test": 5}}
    },
    {#- Anthropic-dialect examples (R9): the upstream speaks OpenAI, so
        specs run-tests (local_testing) calls it in OpenAI form, while the
        gateway path speaks Anthropic and exercises the llm_translator. #}
    "Python code example (Anthropic SDK)": {
      "category": "code_example",
      "description": "Anthropic Messages API via the anthropic SDK; the gateway translates to the upstream",
      "file_path": "anthropic-to-openai-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python",
      "meta": {"requirements": ["openai", "anthropic"], "sleep_after_test": 5}
    },
    "cURL code example (Anthropic style)": {
      "category": "code_example",
      "description": "Anthropic Messages API via cURL; the gateway translates to the upstream",
      "file_path": "anthropic-to-openai-code-example.sh.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "bash",
      "meta": {"sleep_after_test": 5}
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
{%- endif %}
  }
}
